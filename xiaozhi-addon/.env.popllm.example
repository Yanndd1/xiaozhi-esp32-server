# =============================================================================
# PopLLM : variables d'environnement Xiaozhi standalone
# Copier en `.env` sur PopLLM puis renseigner HA_TOKEN. NE PAS COMMITER .env.
#
# Révision 2026-09-01 : latence, verbosité, prononciation.
# =============================================================================

# --- Choix du cerveau -------------------------------------------------
#   ha      RECOMMANDÉ. Délègue au moteur d'intentions de Home Assistant.
#           Les commandes courantes ("ferme le volet du salon") sont traitées
#           en correspondance déterministe, sans LLM : sub-seconde et fiable.
#           Supprime aussi la guerre de VRAM avec l'assistant "Ok Nabu",
#           puisqu'un seul modèle reste chargé sur les 8 Go de la 1070 Ti.
#   popllm  LLM Ollama local. Conversationnel plus riche, mais commandes
#           à ~7 s (le modèle a besoin de raisonner pour appeler une fonction
#           de façon fiable : 6/6 avec raisonnement, 2/6 sans).
#   claude  API Anthropic (payante, sort du réseau).
LLM_BACKEND=ha

# Agent conversationnel HA à utiliser (LLM_BACKEND=ha uniquement).
# Liste des agents : HA -> Paramètres -> Voix -> Assistants.
HA_AGENT_ID=conversation.home_assistant

# --- LLM local (LLM_BACKEND=popllm uniquement) ------------------------
# En network_mode host, Ollama est sur la machine -> localhost
POPLLM_URL=http://127.0.0.1:11434
# Modèle taillé Home Assistant déjà présent sur PopLLM (`ollama list`).
# Alternatives dispo : qwen3.5:9b, gemma-ha:latest, gemma4:e2b
POPLLM_MODEL=qwen-ha:latest

# Raisonnement sur le chemin des commandes (avec outils).
#   on   défaut, fiable  : appel de fonction émis 6/6, ~7 s
#   off  rapide          : ~1 s, mais appel émis 2/6 seulement, donc le
#                          boîtier annonce l'action sans toujours l'exécuter
OLLAMA_TOOLS_REASONING=on

# --- Longueur et style des réponses -----------------------------------
# Plafond dur. Sans lui, le modèle brodait : l'adjectif "concis" dans le
# prompt ne bride rien. ATTENTION (mesure du 2026-10-07) : avec qwen-ha en
# mode outils, la réflexion du modèle consomme ce même budget avant la
# réponse, 100 à 300 jetons selon la demande. À 140, « ferme le volet du
# bureau » s'arrêtait net après 140 jetons de réflexion, sans action ni
# réponse. 1024 laisse la place ; la longueur parlée est cadrée par le prompt.
LLM_MAX_TOKENS=1024
# 0.3 au lieu du défaut 1.0 : réduit la dérive de langue (le filtre CJK se
# déclenchait et faisait prononcer la phrase de repli).
LLM_TEMPERATURE=0.3

# --- Home Assistant (API externe + token longue durée) ----------------
# HTTPS OBLIGATOIRE depuis le 6 août 2026. HA ne répond plus du tout en
# http clair sur 8123 (« Empty reply from server »), ce qui coupait le
# conteneur de Home Assistant sans qu'aucune erreur ne le signale.
HA_BASE_URL=https://192.168.10.205:8123
# Le certificat est auto-signé, avec CN=homeassistant.local, un nom que ni
# l'hôte ni le conteneur ne résolvent. La vérification TLS échouerait donc
# contre l'adresse IP.
#   false          transport chiffré, certificat non authentifié (curl -k)
#   /chemin/ca.crt vérification réelle, exige une URL en homeassistant.local
HA_VERIFY_TLS=false
# Borne les appels HA. Le provider LLM homeassistant n'en avait aucune :
# une non-réponse de HA bloquait le boîtier indéfiniment.
HA_TIMEOUT=15
# OBLIGATOIRE : créer un token dans HA -> Profil -> Jetons longue durée
HA_TOKEN=
# Liste d'appareils exposés au LLM, format "lieu,nom,entity_id" séparés par ';'
# Ignoré si LLM_BACKEND=ha (c'est HA qui gère alors son propre périmètre).
HA_DEVICES=salon,plafond,light.salon;cuisine,plafond,light.cuisine

# --- Périphérique / réseau --------------------------------------------
# MAC de ton ESP32 Xiaozhi (autorisé à se connecter)
ESP32_MAC=3c:0f:02:de:a8:18
# IP de PopLLM annoncée à l'ESP32 (websocket/OTA)
PUBLIC_IP=192.168.10.84

# --- Reconnaissance vocale --------------------------------------------
# parakeet (multilangue auto, recommandé) | whisper (langue forcée)
ASR_BACKEND=parakeet
# Le Ryzen 9 3900X a 24 threads. Le défaut amont était 4.
ASR_THREADS=12

# --- Divers -----------------------------------------------------------
LANGUAGE=fr
TZ=Europe/Paris
# PROMPT : les accents sont OBLIGATOIRES. Piper phonémise littéralement :
# "Desole ... francais" sans accents se prononce "deuh-zole ... fran-ka-is".
# Laisser vide pour utiliser le défaut du script (déjà accentué et bridé).
PROMPT=Tu es l'assistant vocal de la maison. Réponds toujours en français, en une seule phrase courte, sans préambule ni reformulation de la question. Tu peux consulter et contrôler la maison via Home Assistant. Si tu ne sais pas, dis-le en trois mots.
