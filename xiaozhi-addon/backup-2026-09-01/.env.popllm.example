# =============================================================================
# PopLLM — variables d'environnement Xiaozhi standalone
# Copier en `.env` sur PopLLM puis renseigner HA_TOKEN. NE PAS COMMITER .env.
# =============================================================================

# --- LLM : Ollama local sur PopLLM (aucune clé cloud nécessaire) -------
LLM_BACKEND=popllm
# En network_mode host, Ollama est sur la machine -> localhost
POPLLM_URL=http://127.0.0.1:11434
# Modèle taillé Home Assistant déjà présent sur PopLLM (`ollama list`).
# Alternatives dispo : qwen3.5:9b, gemma-ha:latest
POPLLM_MODEL=qwen-ha:latest

# --- Home Assistant (API externe + token longue durée) ----------------
# HA sur le Pi5. http (valeur testée dans le repo) : pas de souci SSL.
HA_BASE_URL=http://192.168.10.205:8123
# OBLIGATOIRE : créer un token dans HA -> Profil -> Jetons longue durée
HA_TOKEN=
# Liste d'appareils exposés au LLM, format "lieu,nom,entity_id" séparés par ';'
HA_DEVICES=salon,plafond,light.salon;cuisine,plafond,light.cuisine

# --- Périphérique / réseau --------------------------------------------
# MAC de ton ESP32 Xiaozhi (autorisé à se connecter)
ESP32_MAC=3c:0f:02:de:a8:18
# IP de PopLLM annoncée à l'ESP32 (websocket/OTA)
PUBLIC_IP=192.168.10.84

# --- Divers -----------------------------------------------------------
LANGUAGE=fr
TZ=Europe/Paris
PROMPT=Tu es un assistant vocal domotique francais, concis et naturel. Tu peux consulter et controler la maison via Home Assistant.
